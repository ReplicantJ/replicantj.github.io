# Whitelist mode: ignore everything by default, then re-allow only what
# the site needs. New files/dirs must be explicitly added here to be tracked.
/*

# --- Repo meta ---
!/.gitignore
!/.github/
!/README.md
!/CNAME

# --- Build / tooling config ---
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/.env.example

# --- Site source ---
!/index.html
!/specimen.html
!/public/
!/src/

# --- Re-ignored inside whitelisted dirs ---
*.log
*.local
.env
.DS_Store
